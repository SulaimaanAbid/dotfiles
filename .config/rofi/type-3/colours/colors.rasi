    on-secondary-fixed: #251626;
    on-secondary-fixed-variant: #534152;
    secondary-container: #534152;
    on-secondary-container: #f5dbf1;
    tertiary: #f6b8ac;
    tertiary-fixed: #ffdad3;
    tertiary-fixed-dim: #f6b8ac;
    on-tertiary: #4c251e;
    on-tertiary-fixed: #33110b;
    on-tertiary-fixed-variant: #673b33;
    tertiary-container: #673b33;
    on-tertiary-container: #ffdad3;
    error: #ffb4ab;
