  "hyprland/workspaces": {
    "format": "{icon} {windows}",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": 5
    },
    "window-rewrite-default": "󰊠",
    "window-rewrite": {
      // --- Work ---
      "kitty": "󰆍",
      "onlyoffice": "󰏆",
      "firefox": "",#workspaces {
  margin: 4px 5px;
  padding: 6px 6px;
  background-color: @surface_container;
  border-radius: 20px;
}

#workspaces button {
  min-width: 32px;
  padding: 0 4px;
  margin: 0 2px;
  background: transparent;
  border-radius: 16px;
  color: @tertiary;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94)
}

#workspaces button.active {
  padding: 0 12px;
  margin: 0 2px;
  background-color: @primary;
  color: @on_primary;
}

#workspaces button.special {
  color: @tertiary_fixed;
}

#workspaces button:hover {
  background-color: @surface_container_highest;
  color: @primary;
}

#workspaces button.active:hover {
  background-color: @primary;
  color: @on_primary;
}

#workspaces button.empty {
  color: @outline_variant;
}

#workspaces button.urgent {
  color: @error_container;
}

#workspaces button label:first-child {
  margin-right: 8px;
}

#workspaces button label:last-child {
  margin-left: 2px;
}
      "code": "󰨞",
      "azahar": "",
      "obsidian": "󰹕",
      "mousepad": "󱓧",
      // --- Apps ---
      "discord": "",
      "spotify": "",
      "org.kde.kdeconnect.app": "󰦉",
      "org.qbittorrent.qBittorrent": "󰘿",
      // --- Graphics & Visual ---
      "xdg-desktop-portal-gtk": "",
      "thunar": "",
      "yazi": "󰇥",
      "imv": "󰄄",
      "swappy": "󰄄",
      "org.gnome.FileRoller": "",
      "vlc": "󰕼",
      "mpv": "󰕼",
      // --- System ---
      "blueman-manager": "",
      "pavucontrol": "󱕂",
      "nm-connection-editor": "󰐻",
      // --- Tool ---
      "nwg-look": "󰒓",
      "qt5ct": "󰒓",
      "qt6ct": "󰒓",
      "designer": "󰒓",
      "linguist": "󰒓",
      "assistant": "󰒓",
      "pixeltool": "󰒓",
      "qdbusviewer": "󰒓"
    },
    "format-icons": {
      "active": "󰮯",
      "special": "󱁂",
      "default": "󰊠",
      "urgent": "󰧵",
      "empty": ""
    },
    "show-special": true,
    "all-outputs": true
  },



    "clock": {
		"format": "{:%H %M}",
        "format-alt": "{:%a, %d. %b  %H:%M}",
		
    },

    "pulseaudio": {
	"format": "{volume}%  ",
	"format-bluetooth": " {icon} {volume}%",
	"format-muted": "",
	"format-icons": {
		"headphone": "",
		"hands-free": "󰂑",
		"headset": "󰂑",
		"phone": "",
		"phone-muted": "",
		"portable": "",
		"car": "",
		"default": ["󰖀", "󰕾"]
	},
	"scroll-step": 1,
	"on-click": "pavucontrol"
    },

    "cava": {
	//"cava_config": "$XDG_CONFIG_HOME/cava/cava.conf",
	"framerate": 30,
	"autosens": 0,
	"sensitivity": 0.001,
	"bars": 14,
	"lower_cutoff_freq": 50,
	"higher_cutoff_freq": 10000,
	"method": "pulse",
	"source": "auto",
	"stereo": true,
	"reverse": false,
	"monstercat": false,
	"waves": false,
	"noise_reduction": 0.23,
	"input_delay": 2,
	"bar_delimiter": 0,
	"format-icons" : ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
	"actions": {
		"on-click-right": "mode"
	}
    },
}
