{
    "layer": "top",
	// "width": 1000,
	"margin": "5px 0 0 0",
	
    "modules-right": ["cava", "pulseaudio" ],
    "modules-center": ["hyprland/workspaces"],
    "modules-left": ["clock"],
    "modules": ["battery", "clock"],

