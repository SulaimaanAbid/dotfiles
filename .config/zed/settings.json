// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ui_font_family": "JetBrainsMonoNL Nerd Font Propo",
  "terminal": {
    "font_family": ".ZedMono"
  },
  "cli_default_open_behavior": "existing_window",
  "inlay_hints": {
    "show_background": false
  },
  "title_bar": {
    "show_user_picture": true
  },
  "proxy": "",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "experimental.theme_overrides": {
      "background.appearance": "transparent",
      "background": "#00000026",
      "editor.background":"#00000026",
      "title_bar.background": "#00000026",
      "status_bar.background": "#00000026",
      "tab_bar.background": "#00000026",
      "editor.gutter.background": "#00000026",
      "panel.background": "#00000026",
      "surface.background": "#00000026",

      "tab.active_background": "#00000026",
      "tab.inactive_background": "#0000001A",
      "toolbar.background": "#00000026",

      "editor.active_line.background": "#ffffff15"
  },

}
